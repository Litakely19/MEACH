<!--
    Maps every view model to its view. Screens are hosted by the shell and dialogs
    by DialogHostWindow, both through a plain ContentControl, so no view is ever
    instantiated from code.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:administrationVm="clr-namespace:SchoolManagement.WPF.ViewModels.Administration"
                    xmlns:billingVm="clr-namespace:SchoolManagement.WPF.ViewModels.Billing"
                    xmlns:dialogsVm="clr-namespace:SchoolManagement.WPF.ViewModels.Dialogs"
                    xmlns:overviewVm="clr-namespace:SchoolManagement.WPF.ViewModels.Overview"
                    xmlns:paymentsVm="clr-namespace:SchoolManagement.WPF.ViewModels.Payments"
                    xmlns:peopleVm="clr-namespace:SchoolManagement.WPF.ViewModels.People"
                    xmlns:reportsVm="clr-namespace:SchoolManagement.WPF.ViewModels.Reports"
                    xmlns:administration="clr-namespace:SchoolManagement.WPF.Views.Administration"
                    xmlns:billing="clr-namespace:SchoolManagement.WPF.Views.Billing"
                    xmlns:dialogs="clr-namespace:SchoolManagement.WPF.Views.Dialogs"
                    xmlns:overview="clr-namespace:SchoolManagement.WPF.Views.Overview"
                    xmlns:payments="clr-namespace:SchoolManagement.WPF.Views.Payments"
                    xmlns:people="clr-namespace:SchoolManagement.WPF.Views.People"
                    xmlns:reports="clr-namespace:SchoolManagement.WPF.Views.Reports">

    <!-- Screens -->
    <DataTemplate DataType="{x:Type overviewVm:DashboardViewModel}">
        <overview:DashboardView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type peopleVm:StudentListViewModel}">
        <people:StudentListView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type peopleVm:StudentDetailViewModel}">
        <people:StudentDetailView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type peopleVm:AcademicLevelListViewModel}">
        <people:AcademicLevelListView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type peopleVm:SchoolClassListViewModel}">
        <people:SchoolClassListView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type peopleVm:AttendanceSheetViewModel}">
        <people:AttendanceSheetView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type peopleVm:AttendanceReportViewModel}">
        <people:AttendanceReportView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type peopleVm:SchoolYearListViewModel}">
        <people:SchoolYearListView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type billingVm:MonthlyFeeViewModel}">
        <billing:MonthlyFeeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type billingVm:DroitFeeViewModel}">
        <billing:OtherFeeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type billingVm:LivreFeeViewModel}">
        <billing:OtherFeeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type billingVm:MockExamFeeViewModel}">
        <billing:OtherFeeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type billingVm:OfficialExamFeeViewModel}">
        <billing:OtherFeeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type billingVm:CustomOneTimeFeeViewModel}">
        <billing:OtherFeeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type billingVm:InvoiceListViewModel}">
        <billing:InvoiceListView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type billingVm:UnpaidFeeViewModel}">
        <billing:UnpaidFeeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type paymentsVm:PaymentHistoryViewModel}">
        <payments:PaymentHistoryView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type paymentsVm:ReceiptListViewModel}">
        <payments:ReceiptListView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type reportsVm:ReportsViewModel}">
        <reports:ReportsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type administrationVm:UserListViewModel}">
        <administration:UserListView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type administrationVm:PaymentTypeListViewModel}">
        <administration:PaymentTypeListView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type administrationVm:AuditLogViewModel}">
        <administration:AuditLogView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type administrationVm:SettingsViewModel}">
        <administration:SettingsView />
    </DataTemplate>

    <!-- Dialogs -->
    <DataTemplate DataType="{x:Type dialogsVm:TextPromptViewModel}">
        <dialogs:TextPromptView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:ChangePasswordViewModel}">
        <dialogs:ChangePasswordView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:StudentEditViewModel}">
        <dialogs:StudentEditView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:StudentTransferViewModel}">
        <dialogs:StudentTransferView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:AcademicLevelEditViewModel}">
        <dialogs:AcademicLevelEditView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:SchoolClassEditViewModel}">
        <dialogs:SchoolClassEditView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:ClassScheduleEditViewModel}">
        <dialogs:ClassScheduleEditView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:SchoolYearEditViewModel}">
        <dialogs:SchoolYearEditView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:PaymentTypeEditViewModel}">
        <dialogs:PaymentTypeEditView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:InvoiceEditViewModel}">
        <dialogs:InvoiceEditView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:InvoiceDetailViewModel}">
        <dialogs:InvoiceDetailView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:MonthlyFeeGenerationViewModel}">
        <dialogs:MonthlyFeeGenerationView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:OneTimeFeeGenerationViewModel}">
        <dialogs:OneTimeFeeGenerationView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:CombinedBillAndPayViewModel}">
        <dialogs:CombinedBillAndPayView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:PaymentDialogViewModel}">
        <dialogs:PaymentDialogView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:PaymentDetailViewModel}">
        <dialogs:PaymentDetailView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:UserEditViewModel}">
        <dialogs:UserEditView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogsVm:ResetPasswordViewModel}">
        <dialogs:ResetPasswordView />
    </DataTemplate>

</ResourceDictionary>
