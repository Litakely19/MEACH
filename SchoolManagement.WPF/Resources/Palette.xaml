<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryColor">#1B5E9C</Color>
    <Color x:Key="PrimaryDarkColor">#134572</Color>
    <Color x:Key="PrimaryLightColor">#E7F0F9</Color>
    <Color x:Key="AccentColor">#2E9E6B</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="#EEF1F6" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DCE3EC" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#C3CDDB" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2933" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#65748B" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="DangerBrush" Color="#C62828" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B26A00" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FFF6E5" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7F4F" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#E8F5EE" />

    <CornerRadius x:Key="CardCorner">6</CornerRadius>
    <CornerRadius x:Key="ControlCorner">4</CornerRadius>

</ResourceDictionary>
