<UserControl x:Class="SchoolManagement.WPF.Views.Dialogs.InvoiceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Invoice.StudentName}" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,2,0,0">
                    <Run Text="{Binding Invoice.StudentNumber, Mode=OneWay}" />
                    <Run Text=" - " />
                    <Run Text="{Binding Invoice.ClassName, Mode=OneWay}" />
                    <Run Text=" - " />
                    <Run Text="{Binding Invoice.SchoolYearName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,2,0,0">
                    <Run Text="Issued on" />
                    <Run Text="{Binding Invoice.IssueDate, Mode=OneWay, StringFormat=d}" />
                    <Run Text=", due on" />
                    <Run Text="{Binding Invoice.DueDate, Mode=OneWay, StringFormat=d}" />
                    <Run Text=", created by" />
                    <Run Text="{Binding Invoice.CreatedBy, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Top"
                    BorderBrush="{Binding Invoice.Status, Converter={StaticResource StatusToBrushConverter}}">
                <TextBlock Text="{Binding Invoice.Status, Converter={StaticResource EnumDisplayConverter}}"
                           FontSize="12"
                           Foreground="{Binding Invoice.Status, Converter={StaticResource StatusToBrushConverter}}" />
            </Border>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <StackPanel Margin="0,0,32,0">
                <TextBlock Text="Total" Style="{StaticResource CaptionStyle}" />
                <TextBlock Text="{Binding Invoice.TotalAmount, Converter={StaticResource MoneyConverter}}"
                           Style="{StaticResource MetricValueStyle}"
                           FontSize="18" />
            </StackPanel>
            <StackPanel Margin="0,0,32,0">
                <TextBlock Text="Paid" Style="{StaticResource CaptionStyle}" />
                <TextBlock Text="{Binding Invoice.PaidAmount, Converter={StaticResource MoneyConverter}}"
                           Style="{StaticResource MetricValueStyle}"
                           FontSize="18"
                           Foreground="{StaticResource SuccessBrush}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Remaining" Style="{StaticResource CaptionStyle}" />
                <TextBlock Text="{Binding Invoice.RemainingAmount, Converter={StaticResource MoneyConverter}}"
                           Style="{StaticResource MetricValueStyle}"
                           FontSize="18"
                           Foreground="{StaticResource DangerBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Invoice lines" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,8" />

        <DataGrid ItemsSource="{Binding Items}" MaxHeight="220">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Payment type" Binding="{Binding PaymentTypeName}" Width="160" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Period" Binding="{Binding PeriodLabel}" Width="110" />
                <DataGridTextColumn Header="Amount"
                                    Binding="{Binding Amount, Converter={StaticResource MoneyConverter}}"
                                    Width="120" />
                <DataGridTextColumn Header="Paid"
                                    Binding="{Binding PaidAmount, Converter={StaticResource MoneyConverter}}"
                                    Width="120" />
                <DataGridTextColumn Header="Remaining"
                                    Binding="{Binding RemainingAmount, Converter={StaticResource MoneyConverter}}"
                                    Width="120" />
                <DataGridTextColumn Header="Due date" Binding="{Binding DueDate, StringFormat=d}" Width="100" />
                <DataGridTemplateColumn Header="Status" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatusPillStyle}"
                                    BorderBrush="{Binding Status, Converter={StaticResource StatusToBrushConverter}}">
                                <TextBlock Text="{Binding Status, Converter={StaticResource EnumDisplayConverter}}"
                                           FontSize="11"
                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="Payments received" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,8" />

        <Grid>
            <DataGrid ItemsSource="{Binding Payments}" MaxHeight="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Payment" Binding="{Binding PaymentNumber}" Width="140" />
                    <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, StringFormat=d}" Width="110" />
                    <DataGridTextColumn Header="Amount"
                                        Binding="{Binding Amount, Converter={StaticResource MoneyConverter}}"
                                        Width="140" />
                    <DataGridTextColumn Header="Method"
                                        Binding="{Binding PaymentMethod, Converter={StaticResource EnumDisplayConverter}}"
                                        Width="130" />
                    <DataGridTextColumn Header="Received by" Binding="{Binding ReceivedBy}" Width="*" />
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status, Converter={StaticResource EnumDisplayConverter}}"
                                        Width="110" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="No payment has been received against this invoice yet."
                       Style="{StaticResource EmptyStateStyle}"
                       Visibility="{Binding Payments.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button Content="Register a payment"
                    Command="{Binding RegisterPaymentCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="170" />
            <Button Content="Export to PDF"
                    Command="{Binding ExportPdfCommand}"
                    Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
