<UserControl x:Class="SchoolManagement.WPF.Views.Dialogs.InvoiceEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.WPF.Views.Controls">

    <StackPanel>
        <controls:StudentPickerControl DataContext="{Binding Student}" />

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Issue date" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding IssueDate}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Due date" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding DueDate}" />
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Notes" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,20,0,8">
            <TextBlock Text="Invoice lines" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add a line"
                        Command="{Binding AddItemCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="Remove the line"
                        Command="{Binding RemoveItemCommand}"
                        Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  IsReadOnly="False"
                  MaxHeight="260">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Payment type" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.PaymentTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding PaymentType, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name"
                                      BorderThickness="0"
                                      Background="Transparent" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />

                <DataGridTextColumn Header="Amount"
                                    Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130" />

                <DataGridTemplateColumn Header="Month" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Months, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding Month, UpdateSourceTrigger=PropertyChanged}"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      ToolTip="Only for a monthly fee line" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Year"
                                    Binding="{Binding Year, UpdateSourceTrigger=PropertyChanged}"
                                    Width="80" />

                <DataGridTemplateColumn Header="Line due date" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding DueDate, UpdateSourceTrigger=PropertyChanged}"
                                        BorderThickness="0"
                                        Background="Transparent" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock Text="Invoice total" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalAmountLabel}"
                       Style="{StaticResource MetricValueStyle}"
                       FontSize="20"
                       Margin="12,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
