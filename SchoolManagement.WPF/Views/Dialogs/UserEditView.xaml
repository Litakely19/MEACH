<UserControl x:Class="SchoolManagement.WPF.Views.Dialogs.UserEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:SchoolManagement.WPF.Behaviors">

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="First name" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="Last name" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                <TextBlock Text="User name" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                <TextBlock Text="Role" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding SelectedRole}"
                          DisplayMemberPath="DisplayName" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0" VerticalAlignment="Bottom">
                <CheckBox Content="The account can sign in" IsChecked="{Binding IsActive}" />
            </StackPanel>
        </Grid>

        <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="First password"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,20,0,4" />
            <TextBlock Text="{Binding PolicyHint}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox behaviors:PasswordBoxBehavior.BoundPassword="{Binding Password, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Confirm the password" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox behaviors:PasswordBoxBehavior.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <CheckBox Content="Ask for a new password at the first sign in"
                      IsChecked="{Binding MustChangePassword}"
                      Margin="0,14,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
