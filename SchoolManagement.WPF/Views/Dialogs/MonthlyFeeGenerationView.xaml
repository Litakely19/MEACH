<UserControl x:Class="SchoolManagement.WPF.Views.Dialogs.MonthlyFeeGenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.WPF.Views.Controls">

    <StackPanel>
        <TextBlock Text="Creates monthly fee obligations for the selected student, or for every student of a group. Months already billed are skipped."
                   Style="{StaticResource CaptionStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <TextBlock Text="Who to bill" Style="{StaticResource FieldLabelStyle}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Content="Entire group / all groups"
                         IsChecked="{Binding BillEntireGroup}"
                         GroupName="MonthlyBillTarget"
                         Margin="0,0,18,0" />
            <RadioButton Content="One student"
                         IsChecked="{Binding BillSingleStudent}"
                         GroupName="MonthlyBillTarget" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="School year" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding SchoolYears}"
                          SelectedItem="{Binding SelectedSchoolYear}"
                          DisplayMemberPath="DisplayName" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2"
                        Visibility="{Binding BillEntireGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Student group (empty bills every group)" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Classes}"
                          SelectedItem="{Binding SelectedClass}"
                          DisplayMemberPath="DisplayName" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                <TextBlock Text="Payment type" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding PaymentTypes}"
                          SelectedItem="{Binding SelectedPaymentType}"
                          DisplayMemberPath="Name" />
            </StackPanel>

            <Grid Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Amount per month" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding AmountPerMonth, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Due day" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding DueDay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </Grid>

        <controls:StudentPickerControl DataContext="{Binding Student}"
                                       Visibility="{Binding DataContext.BillSingleStudent, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Margin="0,14,0,0" />

        <TextBlock Text="Months to bill" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,6" />

        <Border Style="{StaticResource CardStyle}" Background="{StaticResource SurfaceAltBrush}" Padding="12">
            <ItemsControl ItemsSource="{Binding Months}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Label}"
                                  IsChecked="{Binding IsSelected}"
                                  Width="150"
                                  Margin="0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <CheckBox Content="Only students with an active enrolment"
                  IsChecked="{Binding OnlyActiveStudents}"
                  Margin="0,14,0,0"
                  Visibility="{Binding BillEntireGroup, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
