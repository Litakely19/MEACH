<UserControl x:Class="SchoolManagement.WPF.Views.Dialogs.ResetPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:SchoolManagement.WPF.Behaviors">

    <StackPanel>
        <TextBlock Style="{StaticResource CaptionStyle}" TextWrapping="Wrap">
            <Run Text="Account" />
            <Run Text="{Binding Username, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>

        <TextBlock Text="{Binding PolicyHint}"
                   Style="{StaticResource CaptionStyle}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <TextBlock Text="New password" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,0" />
        <PasswordBox behaviors:PasswordBoxBehavior.BoundPassword="{Binding NewPassword, Mode=TwoWay}" />

        <TextBlock Text="Confirm the new password" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,0" />
        <PasswordBox behaviors:PasswordBoxBehavior.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />

        <CheckBox Content="Ask for a new password at the next sign in"
                  IsChecked="{Binding RequireChangeAtNextLogin}"
                  Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
