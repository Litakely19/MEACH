<UserControl x:Class="SchoolManagement.WPF.Views.Dialogs.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:SchoolManagement.WPF.Behaviors">

    <StackPanel>
        <Border Style="{StaticResource WarningBannerStyle}"
                Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource WarningBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <TextBlock Style="{StaticResource CaptionStyle}">
            <Run Text="Account:" />
            <Run Text="{Binding Username, Mode=OneWay}" />
        </TextBlock>

        <TextBlock Text="Current password" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4" />
        <PasswordBox behaviors:PasswordBoxBehavior.BoundPassword="{Binding CurrentPassword, Mode=TwoWay}" MaxLength="128" />

        <TextBlock Text="New password" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4" />
        <PasswordBox behaviors:PasswordBoxBehavior.BoundPassword="{Binding NewPassword, Mode=TwoWay}" MaxLength="128" />

        <TextBlock Text="Confirm the new password" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4" />
        <PasswordBox behaviors:PasswordBoxBehavior.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" MaxLength="128" />

        <TextBlock Text="{Binding PolicyHint}"
                   Style="{StaticResource CaptionStyle}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
