<UserControl x:Class="SchoolManagement.WPF.Views.Dialogs.PaymentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.WPF.Views.Controls">

    <StackPanel>
        <controls:StudentPickerControl DataContext="{Binding Student}" />

        <TextBlock Text="Obligations to settle (select one or several)"
                   Style="{StaticResource FieldLabelStyle}"
                   Margin="0,16,0,0" />
        <TextBlock Text="Tick several fee types to settle them in one payment. Amounts may be partial."
                   Style="{StaticResource CaptionStyle}"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap" />

        <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                MaxHeight="220"
                Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FeeLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding Fee.PaymentTypeName, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Fee.PeriodLabel, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionStyle}">
                                        <Run Text="{Binding Fee.FirstName, Mode=OneWay}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding Fee.LastName, Mode=OneWay}" />
                                        <Run Text=" · due " />
                                        <Run Text="{Binding Fee.DueDate, Mode=OneWay, StringFormat=d}" />
                                        <Run Text=" · remaining " />
                                        <Run Text="{Binding Fee.RemainingAmount, Mode=OneWay, Converter={StaticResource MoneyConverter}}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBox Grid.Column="2"
                                         Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsSelected}"
                                         VerticalAlignment="Center"
                                         ToolTip="Partial payments are allowed" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Margin="0,10,0,0">
            <Run Text="Total selected: " />
            <Run Text="{Binding SelectedTotalLabel, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Payment date" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding PaymentDate}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Payment method" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding PaymentMethods}"
                          SelectedItem="{Binding PaymentMethod}"
                          ItemTemplate="{StaticResource EnumItemTemplate}" />
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Reference" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Transfer reference, mobile money transaction or cheque number" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Notes" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 Height="56"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top" />

        <CheckBox Content="Print the receipt right away"
                  IsChecked="{Binding PrintReceipt}"
                  Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
