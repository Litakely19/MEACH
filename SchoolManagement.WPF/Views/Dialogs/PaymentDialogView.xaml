<UserControl x:Class="SchoolManagement.WPF.Views.Dialogs.PaymentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.WPF.Views.Controls">

    <StackPanel>
        <controls:StudentPickerControl DataContext="{Binding Student}" />

        <TextBlock Text="Obligation to settle" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0" />
        <ComboBox ItemsSource="{Binding OutstandingFees}" SelectedItem="{Binding SelectedFee}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding PeriodLabel, Mode=OneWay}" />
                        <Run Text=" - due " />
                        <Run Text="{Binding DueDate, Mode=OneWay, StringFormat=d}" />
                        <Run Text=" - remaining " />
                        <Run Text="{Binding RemainingAmount, Mode=OneWay, Converter={StaticResource MoneyConverter}}" />
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Remaining on this obligation" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="{Binding RemainingLabel}"
                           Style="{StaticResource MetricValueStyle}"
                           FontSize="18" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Amount received" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="A smaller amount registers a partial payment" />
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Payment date" Style="{StaticResource FieldLabelStyle}" />
                <DatePicker SelectedDate="{Binding PaymentDate}" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Payment method" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding PaymentMethods}"
                          SelectedItem="{Binding PaymentMethod}"
                          ItemTemplate="{StaticResource EnumItemTemplate}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Reference" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Transfer reference, mobile money transaction or cheque number" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Notes" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 Height="56"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top" />

        <CheckBox Content="Print the receipt right away"
                  IsChecked="{Binding PrintReceipt}"
                  Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
