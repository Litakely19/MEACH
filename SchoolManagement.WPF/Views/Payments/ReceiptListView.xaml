<UserControl x:Class="SchoolManagement.WPF.Views.Payments.ReceiptListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.WPF.Views.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarPanelStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             MinWidth="220"
                             Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by receipt number, payment number or student">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBlock Text="Issued from" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                        <DatePicker Width="130" Margin="8,0,0,0" SelectedDate="{Binding From}" />
                        <TextBlock Text="to" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="8,0" />
                        <DatePicker Width="130" SelectedDate="{Binding To}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Search"
                            Margin="10,0,0,0"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Print receipt"
                            Command="{Binding PrintCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="140"
                            ToolTip="Counts as a print; a second print is marked as a reprint" />
                    <Button Content="Export PDF"
                            Command="{Binding ExportPdfCommand}"
                            Margin="10,0,0,0" />
                    <Button Content="Open payment"
                            Command="{Binding OpenPaymentCommand}"
                            Margin="10,0,0,0" />
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenPaymentCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNumber}" Width="140" />
                            <DataGridTextColumn Header="Issued" Binding="{Binding IssueDate, StringFormat=g}" Width="150" />
                            <DataGridTextColumn Header="Payment" Binding="{Binding PaymentNumber}" Width="140" />
                            <DataGridTextColumn Header="Student number" Binding="{Binding StudentNumber}" Width="120" />
                            <DataGridTextColumn Header="First name" Binding="{Binding FirstName}" Width="120" />
                            <DataGridTextColumn Header="Last name" Binding="{Binding LastName}" Width="120" />
                            <DataGridTextColumn Header="Group" Binding="{Binding StudentGroupName}" Width="140" />
                            <DataGridTextColumn Header="Amount"
                                                Binding="{Binding Amount, Converter={StaticResource MoneyConverter}}"
                                                Width="130" />
                            <DataGridTextColumn Header="Method"
                                                Binding="{Binding PaymentMethod, Converter={StaticResource EnumDisplayConverter}}"
                                                Width="120" />
                            <DataGridTextColumn Header="Issued by" Binding="{Binding IssuedBy}" Width="140" />
                            <DataGridTextColumn Header="Prints" Binding="{Binding PrintCount}" Width="70" />
                            <DataGridTemplateColumn Header="Payment status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusPillStyle}"
                                                BorderBrush="{Binding PaymentStatus, Converter={StaticResource StatusToBrushConverter}}">
                                            <TextBlock Text="{Binding PaymentStatus, Converter={StaticResource EnumDisplayConverter}}"
                                                       FontSize="11"
                                                       Foreground="{Binding PaymentStatus, Converter={StaticResource StatusToBrushConverter}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="No receipt matches these criteria."
                               Style="{StaticResource EmptyStateStyle}"
                               Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                </Grid>

                <controls:PagerControl Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
