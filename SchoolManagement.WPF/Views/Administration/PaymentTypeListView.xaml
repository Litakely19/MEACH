<UserControl x:Class="SchoolManagement.WPF.Views.Administration.PaymentTypeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarPanelStyle}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="New payment type"
                        Command="{Binding CreateCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="170" />
                <Button Content="Edit" Command="{Binding EditCommand}" Margin="10,0,0,0" />
                <Button Content="{Binding ToggleActiveLabel}"
                        Command="{Binding ToggleActiveCommand}"
                        Margin="10,0,0,0"
                        MinWidth="120" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="10,0,0,0" />
                <CheckBox Content="Show inactive types"
                          IsChecked="{Binding IncludeInactive}"
                          Margin="20,0,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
            <Grid>
                <DataGrid ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="Default amount"
                                            Binding="{Binding DefaultAmount, Converter={StaticResource MoneyConverter}}"
                                            Width="160" />
                        <DataGridTextColumn Header="Frequency"
                                            Binding="{Binding Frequency, Converter={StaticResource EnumDisplayConverter}}"
                                            Width="130" />
                        <DataGridTemplateColumn Header="State" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Active"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="Inactive"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="No payment type has been defined yet."
                           Style="{StaticResource EmptyStateStyle}"
                           Visibility="{Binding PaymentTypes.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
