<UserControl x:Class="SchoolManagement.WPF.Views.Administration.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.WPF.Views.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarPanelStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         MinWidth="220"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search in the description, the entity or its identifier">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <ComboBox Grid.Column="1"
                          Width="180"
                          Margin="10,0,0,0"
                          ItemsSource="{Binding ActionOptions}"
                          SelectedItem="{Binding SelectedAction}"
                          DisplayMemberPath="Label" />

                <ComboBox Grid.Column="2"
                          Width="180"
                          Margin="10,0,0,0"
                          ItemsSource="{Binding UserOptions}"
                          SelectedItem="{Binding SelectedUser}"
                          DisplayMemberPath="Label" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0">
                    <TextBlock Text="From" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                    <DatePicker Width="130" Margin="8,0,0,0" SelectedDate="{Binding From}" />
                    <TextBlock Text="to" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="8,0" />
                    <DatePicker Width="130" SelectedDate="{Binding To}" />
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Refresh"
                        Margin="10,0,0,0"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding CreatedAt, StringFormat=g}" Width="150" />
                            <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="160" />
                            <DataGridTextColumn Header="Action"
                                                Binding="{Binding Action, Converter={StaticResource EnumDisplayConverter}}"
                                                Width="170" />
                            <DataGridTextColumn Header="Entity" Binding="{Binding EntityName}" Width="130" />
                            <DataGridTextColumn Header="Identifier" Binding="{Binding EntityId}" Width="90" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="No entry matches these filters."
                               Style="{StaticResource EmptyStateStyle}"
                               Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                </Grid>

                <controls:PagerControl Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
