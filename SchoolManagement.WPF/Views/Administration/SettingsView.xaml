<UserControl x:Class="SchoolManagement.WPF.Views.Administration.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="920" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- School identity -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                               Text="School identity"
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                               Text="These details appear on every invoice and every receipt."
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,0,0,14" />

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="School name" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Phone number" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,12,0,0">
                        <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,12,0,0">
                        <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Website" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,0" />
                        <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,12,0,0">
                        <TextBlock Text="Logo shown on printed documents" Style="{StaticResource FieldLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding LogoPath}" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseLogoCommand}" Margin="10,0,0,0" />
                            <Button Grid.Column="2" Content="Remove" Command="{Binding ClearLogoCommand}" Margin="10,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Billing and documents -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="5"
                               Text="Billing and documents"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,14" />

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Currency code" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="Currency symbol" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="4">
                        <TextBlock Text="Default due day of the month" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding DefaultDueDay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Margin="0,12,0,0">
                        <TextBlock Text="Receipt footer" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Maintenance -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Maintenance" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding DatabasePath}"
                               Style="{StaticResource CaptionStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Back up the database"
                                Command="{Binding BackupCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="180" />
                        <Button Content="Recompute overdue fees"
                                Command="{Binding RefreshOverdueCommand}"
                                Margin="10,0,0,0"
                                MinWidth="200" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="Save settings"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="150" />
                <Button Content="Discard changes"
                        Command="{Binding ReloadCommand}"
                        Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
