<UserControl x:Class="SchoolManagement.WPF.Views.People.AttendanceReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarPanelStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          Width="140"
                          ItemsSource="{Binding Levels}"
                          SelectedItem="{Binding SelectedLevel}"
                          DisplayMemberPath="DisplayName" />

                <ComboBox Grid.Column="1"
                          Width="240"
                          Margin="10,0,0,0"
                          ItemsSource="{Binding Groups}"
                          SelectedItem="{Binding SelectedGroup}"
                          DisplayMemberPath="DisplayName" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="From" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                    <DatePicker Width="130" Margin="8,0,0,0" SelectedDate="{Binding From}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0">
                    <TextBlock Text="to" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                    <DatePicker Width="130" Margin="8,0,0,0" SelectedDate="{Binding To}" />
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Run report"
                        Margin="10,0,0,0"
                        Command="{Binding RunCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
            <Grid>
                <DataGrid ItemsSource="{Binding Rows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Number" Binding="{Binding StudentNumber}" Width="120" />
                        <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="*" />
                        <DataGridTextColumn Header="Level" Binding="{Binding AcademicLevelName}" Width="80" />
                        <DataGridTextColumn Header="Group" Binding="{Binding StudentGroupName}" Width="160" />
                        <DataGridTextColumn Header="Sessions" Binding="{Binding TotalSessions}" Width="90" />
                        <DataGridTextColumn Header="Present" Binding="{Binding Present}" Width="80" />
                        <DataGridTextColumn Header="Absent" Binding="{Binding Absent}" Width="80" />
                        <DataGridTextColumn Header="Late" Binding="{Binding Late}" Width="70" />
                        <DataGridTextColumn Header="Excused" Binding="{Binding Excused}" Width="80" />
                        <DataGridTextColumn Header="Attendance %" Binding="{Binding AttendancePercentage}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="No attendance has been recorded for these filters."
                           Style="{StaticResource EmptyStateStyle}"
                           Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
