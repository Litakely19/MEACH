<UserControl x:Class="SchoolManagement.WPF.Views.People.AcademicLevelListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarPanelStyle}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="New level"
                        Command="{Binding CreateCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="120" />
                <Button Content="Edit" Command="{Binding EditCommand}" Margin="10,0,0,0" />
                <Button Content="{Binding ToggleActiveLabel}" Command="{Binding ToggleActiveCommand}" Margin="10,0,0,0" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <DataGrid ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding Name}" Width="100" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Groups" Binding="{Binding GroupCount}" Width="90" />
                            <DataGridTextColumn Header="Students" Binding="{Binding StudentCount}" Width="90" />
                            <DataGridTemplateColumn Header="State" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                                                    <Setter Property="Text" Value="Inactive" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Active" />
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="No academic level has been created yet."
                               Style="{StaticResource EmptyStateStyle}"
                               Visibility="{Binding Levels.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}">
                        <Run Text="Groups of" />
                        <Run Text="{Binding SelectedLevel.Name, Mode=OneWay}" />
                    </TextBlock>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <DataGrid ItemsSource="{Binding Groups}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Group" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Students" Binding="{Binding StudentCount}" Width="90" />
                                <DataGridTextColumn Header="Sessions" Binding="{Binding ScheduleCount}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="This level has no student group yet."
                                   Style="{StaticResource EmptyStateStyle}"
                                   Visibility="{Binding Groups.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
