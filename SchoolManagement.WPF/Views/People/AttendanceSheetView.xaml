<UserControl x:Class="SchoolManagement.WPF.Views.People.AttendanceSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarPanelStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              Width="140"
                              ItemsSource="{Binding Levels}"
                              SelectedItem="{Binding SelectedLevel}"
                              DisplayMemberPath="DisplayName" />

                    <ComboBox Grid.Column="1"
                              Width="260"
                              Margin="10,0,0,0"
                              ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup}"
                              DisplayMemberPath="DisplayName" />

                    <DatePicker Grid.Column="2"
                                Width="150"
                                Margin="10,0,0,0"
                                SelectedDate="{Binding Date}" />

                    <Button Grid.Column="3"
                            Content="Load session"
                            Margin="10,0,0,0"
                            Command="{Binding LoadSheetCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Mark all present"
                            Command="{Binding MarkAllPresentCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="150" />
                    <Button Content="Mark selected absent"
                            Command="{Binding MarkSelectedAbsentCommand}"
                            Margin="10,0,0,0" />
                    <Button Content="Save attendance"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="150"
                            Margin="10,0,0,0" />
                    <TextBlock Margin="18,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionStyle}"
                               Text="{Binding SessionLabel}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
            <Grid>
                <DataGrid ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Number" Binding="{Binding StudentNumber}" Width="130" />
                        <DataGridTextColumn Header="Number" Binding="{Binding StudentNumber}" Width="120" />
                        <DataGridTextColumn Header="First name" Binding="{Binding FirstName}" Width="*" />
                        <DataGridTextColumn Header="Last name" Binding="{Binding LastName}" Width="*" />
                        <DataGridTemplateColumn Header="Status" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Statuses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                              ItemTemplate="{StaticResource EnumItemTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Select a student group and a date, then load the scheduled session."
                           Style="{StaticResource EmptyStateStyle}"
                           Visibility="{Binding Students.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
