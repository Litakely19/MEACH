<UserControl x:Class="SchoolManagement.WPF.Views.People.SchoolClassListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarPanelStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by class name or level">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <ComboBox Grid.Column="1"
                              Width="190"
                              Margin="10,0,0,0"
                              ItemsSource="{Binding LevelOptions}"
                              SelectedItem="{Binding SelectedLevel}"
                              DisplayMemberPath="Label" />

                    <ComboBox Grid.Column="2"
                              Width="170"
                              Margin="10,0,0,0"
                              ItemsSource="{Binding ActivityOptions}"
                              SelectedItem="{Binding SelectedActivity}"
                              DisplayMemberPath="Label" />

                    <Button Grid.Column="3"
                            Content="Search"
                            Margin="10,0,0,0"
                            Command="{Binding SearchCommand}" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="New group"
                            Command="{Binding CreateCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="120" />
                    <Button Content="Edit" Command="{Binding EditCommand}" Margin="10,0,0,0" />
                    <Button Content="{Binding ToggleActiveLabel}" Command="{Binding ToggleActiveCommand}" Margin="10,0,0,0" />
                    <Button Content="Archive"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <DataGrid ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Group" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Level" Binding="{Binding AcademicLevelName}" Width="80" />
                            <DataGridTextColumn Header="Students" Binding="{Binding StudentCount}" Width="90" />
                            <DataGridTextColumn Header="Sessions" Binding="{Binding ScheduleCount}" Width="90" />
                            <DataGridTemplateColumn Header="State" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                                                    <Setter Property="Text" Value="Inactive" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Active" />
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="No class matches these criteria."
                               Style="{StaticResource EmptyStateStyle}"
                               Visibility="{Binding Classes.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}">
                        <Run Text="Students of" />
                        <Run Text="{Binding SelectedClass.Name, Mode=OneWay}" />
                    </TextBlock>

                    <Button Grid.Row="1"
                            Content="Open the student file"
                            Command="{Binding OpenStudentCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10" />

                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}">
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenStudentCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Number" Binding="{Binding StudentNumber}" Width="120" />
                                <DataGridTextColumn Header="First name" Binding="{Binding FirstName}" Width="*" />
                                <DataGridTextColumn Header="Last name" Binding="{Binding LastName}" Width="*" />
                                <DataGridTextColumn Header="Outstanding"
                                                    Binding="{Binding OutstandingBalance, Converter={StaticResource MoneyConverter}}"
                                                    Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="This group has no student yet."
                                   Style="{StaticResource EmptyStateStyle}"
                                   Visibility="{Binding Students.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                    </Grid>

                    <TextBlock Grid.Row="3" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,8" Text="Schedule" />

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Add session" Command="{Binding AddScheduleCommand}" />
                        <Button Content="Edit" Command="{Binding EditScheduleCommand}" Margin="8,0,0,0" />
                        <Button Content="Remove" Command="{Binding DeleteScheduleCommand}" Margin="8,0,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="5">
                        <DataGrid ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Day" Binding="{Binding DayOfWeek, Converter={StaticResource EnumDisplayConverter}}" Width="*" />
                                <DataGridTextColumn Header="Session" Binding="{Binding SessionLabel}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="This group has no class session yet."
                                   Style="{StaticResource EmptyStateStyle}"
                                   Visibility="{Binding Schedules.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
