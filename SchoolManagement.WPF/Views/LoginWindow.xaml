<Window x:Class="SchoolManagement.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:SchoolManagement.WPF.Behaviors"
        Title="Sign in"
        Width="880"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Branding panel -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="32">
                <StackPanel VerticalAlignment="Center">
                    <Border Width="56"
                            Height="56"
                            CornerRadius="28"
                            Background="#33FFFFFF"
                            HorizontalAlignment="Left">
                        <TextBlock Text="SP"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{Binding SchoolName}"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,24,0,0" />

                    <TextBlock Text="Student and payment management"
                               Foreground="#CFE0F0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <Separator Background="#33FFFFFF" Margin="0,24" />

                    <TextBlock Text="Students, invoices, receipts and financial reports in one place."
                               Foreground="#CFE0F0"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="{Binding VersionLabel}"
                           Foreground="#9FC0DC"
                           FontSize="11"
                           VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <!-- Credentials -->
        <Grid Grid.Column="1" Margin="48,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sign in" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Use the account provided by your administrator."
                           Style="{StaticResource PageSubtitleStyle}"
                           Margin="0,6,0,24" />

                <Border Style="{StaticResource ErrorBannerStyle}"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="60" />

                <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,4" />
                <PasswordBox behaviors:PasswordBoxBehavior.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="128" />

                <Button Content="Sign in"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Height="38"
                        Margin="0,24,0,0" />

                <ProgressBar IsIndeterminate="True"
                             Margin="0,12,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
