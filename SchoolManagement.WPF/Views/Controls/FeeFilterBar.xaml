<!--
    Filter bar shared by the three fee screens. It binds to the ambient data
    context, which is always a FeeListViewModelBase.
-->
<UserControl x:Class="SchoolManagement.WPF.Views.Controls.FeeFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0"
                 MinWidth="200"
                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Search by student name or student number">
            <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
            </TextBox.InputBindings>
        </TextBox>

        <ComboBox Grid.Column="1"
                  Width="160"
                  Margin="10,0,0,0"
                  ItemsSource="{Binding AcademicLevelOptions}"
                  SelectedItem="{Binding SelectedAcademicLevel}"
                  DisplayMemberPath="Label" />

        <ComboBox Grid.Column="2"
                  Width="150"
                  Margin="10,0,0,0"
                  ItemsSource="{Binding StudentGroupOptions}"
                  SelectedItem="{Binding SelectedStudentGroup}"
                  DisplayMemberPath="Label" />

        <ComboBox Grid.Column="3"
                  Width="160"
                  Margin="10,0,0,0"
                  ItemsSource="{Binding PaymentTypeOptions}"
                  SelectedItem="{Binding SelectedPaymentType}"
                  DisplayMemberPath="Label" />

        <ComboBox Grid.Column="4"
                  Width="120"
                  Margin="10,0,0,0"
                  ItemsSource="{Binding MonthOptions}"
                  SelectedItem="{Binding SelectedMonth}"
                  DisplayMemberPath="Label" />

        <ComboBox Grid.Column="5"
                  Width="140"
                  Margin="10,0,0,0"
                  ItemsSource="{Binding StatusOptions}"
                  SelectedItem="{Binding SelectedStatus}"
                  DisplayMemberPath="Label" />

        <CheckBox Grid.Column="6"
                  Content="Outstanding only"
                  Margin="14,0,0,0"
                  IsChecked="{Binding OnlyOutstanding}" />

        <Button Grid.Column="7"
                Content="Search"
                Margin="10,0,0,0"
                Command="{Binding SearchCommand}"
                Style="{StaticResource SecondaryButtonStyle}" />
    </Grid>
</UserControl>
