<!--
    Student search used by the payment and invoice dialogs. Its data context is a
    StudentPicker, so a dialog only has to bind it to its own picker instance.
-->
<UserControl x:Class="SchoolManagement.WPF.Views.Controls.StudentPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Student" Style="{StaticResource FieldLabelStyle}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Type a name or a student number, then press Enter">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="1"
                    Content="Search"
                    Margin="10,0,0,0"
                    Command="{Binding SearchCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>

        <ComboBox Margin="0,8,0,0"
                  ItemsSource="{Binding Results}"
                  SelectedItem="{Binding SelectedStudent}"
                  DisplayMemberPath="DisplayName"
                  Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisibilityConverter}, ConverterParameter=invert}" />

        <Border Style="{StaticResource CardStyle}"
                Background="{StaticResource SurfaceAltBrush}"
                Padding="12,10"
                Margin="0,8,0,0"
                Visibility="{Binding SelectedStudent, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding SelectedStudent.FullName}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,2,0,0">
                    <Run Text="{Binding SelectedStudent.StudentNumber, Mode=OneWay}" />
                    <Run Text=" - " />
                    <Run Text="{Binding SelectedStudent.ClassName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,2,0,0">
                    <Run Text="Outstanding balance:" />
                    <Run Text="{Binding SelectedStudent.OutstandingBalance, Mode=OneWay, Converter={StaticResource MoneyConverter}}" />
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
