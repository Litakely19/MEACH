<!--
    Fee lines grid shared by the monthly, one time and unpaid fee screens. Double
    clicking a line registers a payment for it. Column visibility is driven by the
    host FeeListViewModelBase (Livre hides Period / Payment type and shows Description).
-->
<UserControl x:Class="SchoolManagement.WPF.Views.Controls.FeeGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SchoolManagement.WPF.Views.Controls">

    <Border Style="{StaticResource CardStyle}" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Proxy keeps column Visibility bindings on the view-model DataContext. -->
            <FrameworkElement x:Name="DataContextProxy" DataContext="{Binding}" Visibility="Collapsed" />

            <Grid Grid.Row="0">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding RegisterPaymentCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Number" Binding="{Binding StudentNumber}" Width="120" />
                        <DataGridTextColumn Header="First name" Binding="{Binding FirstName}" Width="120" />
                        <DataGridTextColumn Header="Last name" Binding="{Binding LastName}" Width="120" />
                        <DataGridTextColumn Header="Group" Binding="{Binding StudentGroupName}" Width="140" />
                        <DataGridTextColumn Header="Payment type"
                                            Binding="{Binding PaymentTypeName}"
                                            Width="150"
                                            Visibility="{Binding DataContext.ShowPaymentTypeColumn, Source={x:Reference DataContextProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <DataGridTextColumn Header="Period"
                                            Binding="{Binding PeriodLabel}"
                                            Width="120"
                                            Visibility="{Binding DataContext.ShowPeriodColumn, Source={x:Reference DataContextProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding Description}"
                                            Width="*"
                                            Visibility="{Binding DataContext.ShowDescriptionColumn, Source={x:Reference DataContextProxy}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <DataGridTextColumn Header="Expected"
                                            Binding="{Binding ExpectedAmount, Converter={StaticResource MoneyConverter}}"
                                            Width="120" />
                        <DataGridTextColumn Header="Paid"
                                            Binding="{Binding PaidAmount, Converter={StaticResource MoneyConverter}}"
                                            Width="120" />
                        <DataGridTextColumn Header="Remaining"
                                            Binding="{Binding RemainingAmount, Converter={StaticResource MoneyConverter}}"
                                            Width="120" />
                        <DataGridTextColumn Header="Due date"
                                            Binding="{Binding DueDate, StringFormat=d}"
                                            Width="100" />
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPillStyle}"
                                            BorderBrush="{Binding Status, Converter={StaticResource StatusToBrushConverter}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource EnumDisplayConverter}}"
                                                   FontSize="11"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="No fee line matches these filters."
                           Style="{StaticResource EmptyStateStyle}"
                           Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
            </Grid>

            <controls:PagerControl Grid.Row="1" />
        </Grid>
    </Border>
</UserControl>
