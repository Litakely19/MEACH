<UserControl x:Class="SchoolManagement.WPF.Views.Overview.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- One metric tile: caption on top, figure below, optional detail line. -->
        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinWidth" Value="210" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Scope -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarPanelStyle}" Margin="0,0,0,12">
            <TextBlock Text="Live snapshot of students, groups, collections and attendance."
                       Style="{StaticResource CaptionStyle}"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Metrics -->
        <ItemsControl Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Total students" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding Summary.TotalStudents}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource CaptionStyle}">
                        <Run Text="{Binding Summary.L1Students, Mode=OneWay}" />
                        <Run Text="L1 ·" />
                        <Run Text="{Binding Summary.L2Students, Mode=OneWay}" />
                        <Run Text="L2 ·" />
                        <Run Text="{Binding Summary.L3Students, Mode=OneWay}" />
                        <Run Text="L3" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Student groups" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding Summary.ActiveGroups}" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" />
                    <TextBlock Text="Active groups" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Collected today" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding Summary.PaymentsTodayAmount, Converter={StaticResource MoneyConverter}}"
                               Style="{StaticResource MetricValueStyle}"
                               FontSize="20"
                               Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource CaptionStyle}">
                        <Run Text="{Binding Summary.PaymentsTodayCount, Mode=OneWay}" />
                        <Run Text="payments" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Collected this month" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding Summary.PaymentsThisMonthAmount, Converter={StaticResource MoneyConverter}}"
                               Style="{StaticResource MetricValueStyle}"
                               FontSize="20"
                               Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource CaptionStyle}">
                        <Run Text="{Binding Summary.PaymentsThisMonthCount, Mode=OneWay}" />
                        <Run Text="payments" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Total collected" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding Summary.TotalCollected, Converter={StaticResource MoneyConverter}}"
                               Style="{StaticResource MetricValueStyle}"
                               FontSize="20"
                               Foreground="{StaticResource SuccessBrush}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="All collections to date" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Outstanding balance" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding Summary.OutstandingBalance, Converter={StaticResource MoneyConverter}}"
                               Style="{StaticResource MetricValueStyle}"
                               FontSize="20"
                               Foreground="{StaticResource WarningBrush}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="Still to be collected" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="Absent today" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding Summary.AbsentToday}"
                               Style="{StaticResource MetricValueStyle}"
                               Foreground="{StaticResource DangerBrush}"
                               Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource CaptionStyle}">
                        <Run Text="{Binding Summary.OverdueItemCount, Mode=OneWay}" />
                        <Run Text="overdue fees" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </ItemsControl>

        <!-- Collections by type and recent payments -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Collected by type" Style="{StaticResource SectionTitleStyle}" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Summary.CollectedByType}" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding PaymentTypeName}" Width="*" />
                            <DataGridTextColumn Header="Collected"
                                                Binding="{Binding CollectedAmount, Converter={StaticResource MoneyConverter}}"
                                                Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Recent payments" Style="{StaticResource SectionTitleStyle}" />

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <DataGrid ItemsSource="{Binding RecentPayments}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Payment" Binding="{Binding PaymentNumber}" Width="130" />
                                <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding PaymentTypeName}" Width="120" />
                                <DataGridTextColumn Header="Amount"
                                                    Binding="{Binding Amount, Converter={StaticResource MoneyConverter}}"
                                                    Width="120" />
                                <DataGridTextColumn Header="Date"
                                                    Binding="{Binding PaymentDate, StringFormat=d}"
                                                    Width="90" />
                                <DataGridTextColumn Header="Received by" Binding="{Binding ReceivedBy}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="No payment has been registered yet."
                                   Style="{StaticResource EmptyStateStyle}"
                                   Visibility="{Binding RecentPayments.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
