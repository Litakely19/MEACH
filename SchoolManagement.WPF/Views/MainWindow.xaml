<Window x:Class="SchoolManagement.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEACH"
        Width="1360"
        Height="820"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Side navigation ============================ -->
        <Border Grid.Column="0" Background="#12324F">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,20,18,12">
                    <TextBlock Text="{Binding SchoolName}"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SchoolYearLabel}"
                               Foreground="#8FB3D0"
                               FontSize="11"
                               Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding GroupedNavigation}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource NavigationButtonStyle}"
                                             Content="{Binding Title}"
                                             Foreground="White"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource NavigationGroupHeaderStyle}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="#1F4A6E" BorderThickness="0,1,0,0" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="36"
                                Height="36"
                                CornerRadius="18"
                                Background="#2E9E6B">
                            <TextBlock Text="{Binding UserInitials}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserFullName}"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserRoleLabel}"
                                       Foreground="#8FB3D0"
                                       FontSize="11" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Password"
                                        Command="{Binding ChangePasswordCommand}"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Foreground="#BFD6EA"
                                        Padding="0"
                                        FontSize="11" />
                                <TextBlock Text="|" Foreground="#3E6A90" Margin="8,0" FontSize="11" />
                                <Button Content="Sign out"
                                        Command="{Binding LogoutCommand}"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Foreground="#BFD6EA"
                                        Padding="0"
                                        FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================== Work area ============================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid>
                    <TextBlock Text="{Binding SelectedItem.Title}"
                               Style="{StaticResource BaseTextStyle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="Register a payment"
                                Command="{Binding RegisterPaymentCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="150"
                                Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <ProgressBar Grid.Row="1"
                         IsIndeterminate="True"
                         Visibility="{Binding CurrentViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Grid Grid.Row="2" Margin="20,16,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource WarningBannerStyle}"
                        Visibility="{Binding HasDueSoonNotifications, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Dismiss"
                                Command="{Binding DismissDueSoonCommand}"
                                Style="{StaticResource LinkButtonStyle}"
                                Margin="12,0,0,0" />
                        <Button DockPanel.Dock="Right"
                                Content="Open unpaid"
                                Command="{Binding OpenDueSoonCommand}"
                                Style="{StaticResource LinkButtonStyle}"
                                Margin="12,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding DueSoonSummary}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding DueSoonNotifications}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,2">
                                            <Run Text="{Binding FirstName, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding LastName, Mode=OneWay}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding PaymentTypeName, Mode=OneWay}" />
                                            <Run Text=" (" />
                                            <Run Text="{Binding PeriodLabel, Mode=OneWay}" />
                                            <Run Text=") due " />
                                            <Run Text="{Binding DueDate, Mode=OneWay, StringFormat=d}" />
                                            <Run Text=" · remaining " />
                                            <Run Text="{Binding RemainingAmount, Mode=OneWay, Converter={StaticResource MoneyConverter}}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Screens report their outcome here, so no view repeats this markup. -->
                <Border Grid.Row="1"
                        Style="{StaticResource ErrorBannerStyle}"
                        Visibility="{Binding CurrentViewModel.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding CurrentViewModel.ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource SuccessBannerStyle}"
                        Visibility="{Binding CurrentViewModel.HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding CurrentViewModel.StatusMessage}"
                               Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <ContentControl Grid.Row="3" Content="{Binding CurrentViewModel}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
